# [2026-11-24 07:55 PM Johnny Chu - Chu Hoàng Anh] PHASE-016 — mẫu biến môi trường cho docker compose. Chép thành .env (không commit .env).
# Khoá ký phiên — BẮT BUỘC, ngẫu nhiên ≥ 32 ký tự. Tạo: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
# Mật khẩu Postgres của compose (máy dev giữ mặc định được).
DB_PASSWORD=cake-dev
# Đơn vị dev (slug, trục tenant SPINE). PHASE-004 thay bằng đơn vị của người đăng nhập.
CAKE_TENANT=hoa-mai
# 1 = gieo dữ liệu GIẢ LẬP Shop Hoa Mai (máy dev). Bản thật: 0.
CAKE_SEED_DEV=1
WEB_PORT=8110
API_PORT=8120
# Cổng nhận bizcity_touch@1 từ Hub (POST /ingress/v1/touch). Trống ⇒ cổng tắt (503). Khoá ≥ 16 ký tự, bí mật HMAC ≥ 32 ký tự — Hub giữ cùng cặp.
CAKE_HUB_KEY=
CAKE_HUB_SECRET=
# [2026-11-26 12:54 AM Johnny Chu - Chu Hoàng Anh] PHASE-006 S006-3 — tin ra kênh: địa chỉ Hub + khoá site biz-… (thân ký bằng CAKE_HUB_SECRET)
CAKE_HUB_URL=
CAKE_HUB_SITE_KEY=
# Đăng nhập một lần từ WordPress (cùng khuôn vé với open-ketoan). Trống ⇒ tắt.
WP_SSO_SECRET=
WP_SSO_TENANT=hoa-mai
WP_SSO_LOGIN_URL=
# CHỈ máy dev: 1 = web tự đăng nhập làm chủ đơn vị dev. Bản thật: 0 (mặc định).
CAKE_DEV_AUTH=0
# Quan sát (bizcity_observability@1, PHASE-016). Trống ⇒ vẫn có traceId trong log / lỗi, không gửi trace đi đâu.
#   OTEL_EXPORTER_OTLP_ENDPOINT = otel-collector của BỘ GIÁM SÁT CHUNG trên máy chủ (vd http://otel-collector:4318).
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=open-cake-api
# GET /metrics (Prometheus). Không qua nginx; đặt token khi cổng API mở ra ngoài máy (API_BIND khác 127.0.0.1) — Prometheus gửi Bearer.
METRICS_TOKEN=
# Thư mục nhật ký lỗi cố định (logs/api/<ngày>.log, giữ 30 ngày). Trống ⇒ chỉ stdout.
LOG_DIR=
# Mã commit vào trường commit của log: BIZCITY_GIT_SHA=$(git rev-parse HEAD) docker compose build
BIZCITY_GIT_SHA=
# Luồng đơn xuyên app (PHASE-010, bizcity_order_flow@1).
#   CAKE_SECRET_KEY ≥ 32 ký tự: mã hoá khoá / bí mật của cửa hàng (Open POS) trước khi lưu CSDL. Đổi khoá này ⇒ phải dán lại khoá cửa hàng.
CAKE_SECRET_KEY=
#   Khoá Kế Toán (scope stock:read) để đọc tồn — tạm ở biến môi trường tới khi có màn nối Kế Toán (nợ ghi ở apps/api/src/orders/clients.ts).
CAKE_OKT_API_KEY=
