# [2026-11-24 07:55 PM Johnny Chu - Chu Hoàng Anh] PHASE-016 — mẫu biến môi trường cho docker compose. Chép thành .env (không commit .env).
# Khoá ký phiên — BẮT BUỘC, ngẫu nhiên ≥ 32 ký tự. Tạo: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
# Mật khẩu Postgres của compose (máy dev giữ mặc định được).
DB_PASSWORD=cake-dev
# Đơn vị dev (slug, trục tenant SPINE). PHASE-004 thay bằng đơn vị của người đăng nhập.
CAKE_TENANT=hoa-mai
# 1 = gieo dữ liệu GIẢ LẬP Shop Hoa Mai (máy dev). Bản thật: 0.
CAKE_SEED_DEV=1
WEB_PORT=8110
API_PORT=8120
# Cổng nhận bizcity_touch@1 từ Hub (POST /ingress/v1/touch). Trống ⇒ cổng tắt (503). Khoá ≥ 16 ký tự, bí mật HMAC ≥ 32 ký tự — Hub giữ cùng cặp.
CAKE_HUB_KEY=
CAKE_HUB_SECRET=
# Đăng nhập một lần từ WordPress (cùng khuôn vé với open-ketoan). Trống ⇒ tắt.
WP_SSO_SECRET=
WP_SSO_TENANT=hoa-mai
WP_SSO_LOGIN_URL=
# CHỈ máy dev: 1 = web tự đăng nhập làm chủ đơn vị dev. Bản thật: 0 (mặc định).
CAKE_DEV_AUTH=0
